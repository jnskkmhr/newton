+@wp.kernel
+def _exclude_collider_particles(ids: wp.array[int], flags: wp.array[int]):
+    i = ids[wp.tid()]
+    flags[i] = flags[i] & ~int(newton.ParticleFlags.ACTIVE)
+
+
+@wp.kernel
+def _refresh_particle_properties(
+    radius: wp.array[float],
+    mass: wp.array[float],
+    transfer_flags: wp.array[int],
+    volume: wp.array[float],
+    density: wp.array[float],
+    material_flags: wp.array[int],
+    material_volume: wp.array[float],
+    young_modulus: wp.array[float],
+    hardening: wp.array[float],
+    viscosity: wp.array[float],
+    dilatancy: wp.array[float],
+    extrema: wp.array[float],
+):
+    i = wp.tid()
+    v = 8.0 * radius[i] * radius[i] * radius[i]
+    volume[i] = v
+    density[i] = 0.0
+    if v > 0.0:
+        density[i] = mass[i] / v
+    flags = transfer_flags[i]
+    if flags & int(newton.ParticleFlags.PROXY):
+        flags = flags & ~int(newton.ParticleFlags.ACTIVE)
+    material_flags[i] = flags
+    material_volume[i] = 0.0
+    if flags & int(newton.ParticleFlags.ACTIVE):
+        material_volume[i] = v
+        wp.atomic_min(extrema, 0, young_modulus[i])
+        wp.atomic_max(extrema, 1, hardening[i])
+        if viscosity[i] > 0.0:
+            wp.atomic_max(extrema, 2, 1.0)
+        if dilatancy[i] > 0.0:
+            wp.atomic_max(extrema, 3, 1.0)
+
+
