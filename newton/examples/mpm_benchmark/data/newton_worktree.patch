+    def notify_particle_properties_changed(self):
+        """Refresh changing particle properties in stable device arrays.
+
+        Material arrays and collider membership must already be current. The
+        four extrema needed by Python solver dispatch are the only readback.
+        """
+        model = self.model
+        if model.particle_count != self.particle_volume.size:
+            raise ValueError("Particle count changes require rebuilding the MPM solver")
+        self.particle_radius = model.particle_radius
+        if not hasattr(self, "_particle_property_extrema"):
+            self._particle_property_extrema = wp.empty(4, dtype=float, device=model.device)
+        # max_hardening has historically been zero only for an empty material set.
+        self._particle_property_extrema.assign([math.inf, -math.inf, 0.0, 0.0])
+        wp.copy(self.particle_flags, model.particle_flags)
+        ids = getattr(self.collider, "collider_particle_ids", None)
+        if ids is not None and ids.size:
+            wp.launch(_exclude_collider_particles, dim=ids.size, inputs=[ids, self.particle_flags], device=model.device)
+        material = self.material_parameters
+        wp.launch(
+            _refresh_particle_properties,
+            dim=model.particle_count,
+            inputs=[
+                self.particle_radius,
+                model.particle_mass,
+                self.particle_flags,
+                self.particle_volume,
+                self.particle_density,
+                self.material_particle_flags,
+                self.material_particle_volume,
+                material.young_modulus,
+                material.hardening,
+                material.viscosity,
+                material.dilatancy,
+                self._particle_property_extrema,
+            ],
+            device=model.device,
+        )
+        young, hardening, viscosity, dilatancy = self._particle_property_extrema.numpy()
+        self.min_young_modulus = float(young)
+        self.max_hardening = 0.0 if hardening == -math.inf else float(hardening)
+        self.has_viscosity = bool(viscosity)
